# Server-only settings. Copy to a private path, never to web/public or a submission ZIP.
DEEPSEEK_API_KEY=REPLACE_LOCALLY
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
TUTOR_PORT=4174
TUTOR_ALLOWED_ORIGINS=http://127.0.0.1:4174,http://localhost:4174
TUTOR_RATE_LIMIT=12
TUTOR_TIMEOUT_MS=25000
TUTOR_TRUST_PROXY=0
