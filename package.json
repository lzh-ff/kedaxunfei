{
  "name": "vocational-adaptive-tutor",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/core.test.mjs tests/mastery.test.mjs tests/chat-proxy.test.mjs tests/chat-client.test.mjs tests/answer-format.test.mjs tests/local-app.test.mjs",
    "test:e2e": "node tests/adaptive-e2e.mjs",
